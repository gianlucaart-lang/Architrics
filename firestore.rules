rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- REUSABLE HELPERS ---
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    
    // --- ESTIMATES COLLECTION ---
    match /estimates/{estimateId} {
      allow get: if isOwner(existing().userId);
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      
      allow create: if isSignedIn() 
        && isOwner(incoming().userId)
        && isValidEstimate(incoming());
        
      allow update: if isOwner(existing().userId)
        && isOwner(incoming().userId) // Prevent changing owner
        && isValidEstimate(incoming())
        && (
          incoming().diff(existing()).affectedKeys().hasOnly(['clientName', 'config', 'total', 'items', 'precision', 'isPinned'])
          || incoming().diff(existing()).affectedKeys().hasOnly(['clientName', 'config', 'total', 'items', 'precision', 'isPinned', 'updatedAt'])
        );
        
      allow delete: if isOwner(existing().userId);
    }

    function isValidEstimate(data) {
      return data.keys().hasAll(['clientName', 'date', 'total', 'items', 'config', 'userId', 'precision'])
        && data.clientName is string && data.clientName.size() <= 200
        && data.date is string
        && data.total is list && data.total.size() == 2
        && data.items is list
        && data.config is map
        && data.userId == request.auth.uid
        && data.precision in ['preliminary', 'developed', 'executive']
        && ( !('isPinned' in data) || data.isPinned is bool );
    }
  }
}
